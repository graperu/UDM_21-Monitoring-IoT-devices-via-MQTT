{
  "broker": {
    "host": "localhost",
    "port": 1883,
    "use_tls": false,
    "keepalive": 60,
    "username_env": "UDM21_MQTT_USERNAME",
    "password_env": "UDM21_MQTT_PASSWORD"
  },
  "topics": {
    "root": "udm21_nhom01",
    "telemetry_wildcard": "udm21_nhom01/+/+/+/telemetry",
    "status_wildcard": "udm21_nhom01/+/+/+/status",
    "command_pattern": "udm21_nhom01/{location}/{device_type}/{device_id}/cmd"
  },
  "storage": {
    "database": "Extra/data/telemetry.db",
    "visible_messages_per_device": 20,
    "stored_messages_per_device": 10000
  },
  "thresholds": {
    "temperature_max": 40.0,
    "humidity_max": 85.0,
    "air_quality_aqi_max": 150.0,
    "power_watt_max": 3000.0
  }
}
