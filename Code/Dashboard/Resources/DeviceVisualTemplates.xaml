<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:UDM_21.Dashboard.Models">

    <!-- Simple, Professional Engineering Symbols (24x24 monochrome / muted) -->

    <!-- 1. Smart Light Symbol -->
    <DataTemplate x:Key="SmartLightVisualTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="M 9,21 L 15,21 M 10,23 L 14,23 M 12,2 C 7.58,2 4,5.58 4,10 C 4,12.76 5.4,15.19 7.5,16.5 L 7.5,19 L 16.5,19 L 16.5,16.5 C 18.6,15.19 20,12.76 20,10 C 20,5.58 16.42,2 12,2 Z"
                      Stroke="#475569" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- 2. Door Sensor Symbol -->
    <DataTemplate x:Key="DoorSensorVisualTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Rectangle Canvas.Left="3" Canvas.Top="2" Width="14" Height="20" Stroke="#475569" StrokeThickness="1.8" Fill="Transparent"/>
                <Ellipse Canvas.Left="13" Canvas.Top="12" Width="2.5" Height="2.5" Fill="#475569"/>
                <Rectangle Canvas.Left="19" Canvas.Top="7" Width="3" Height="10" Fill="#2563EB"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- 3. Power Meter Symbol -->
    <DataTemplate x:Key="PowerMeterVisualTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Rectangle Canvas.Left="2" Canvas.Top="3" Width="20" Height="18" RadiusX="2" RadiusY="2" Stroke="#475569" StrokeThickness="1.8" Fill="Transparent"/>
                <Path Data="M 13,7 L 9,13 L 13,13 L 11,18 L 16,11 L 12,11 Z" Fill="#D97706"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- 4. Air Quality Symbol -->
    <DataTemplate x:Key="AirQualityVisualTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="M 3,8 C 7,8 8,5 12,5 C 16,5 17,8 21,8 M 3,12 C 7,12 8,9 12,9 C 16,9 17,12 21,12 M 3,16 C 7,16 8,13 12,13 C 16,13 17,16 21,16"
                      Stroke="#0284C7" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- 5. Climate Sensor Symbol -->
    <DataTemplate x:Key="TempHumVisualTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="M 10,14.5 L 10,5 C 10,3.9 10.9,3 12,3 C 13.1,3 14,3.9 14,5 L 14,14.5 C 15.5,15.6 16.2,17.5 15.5,19.3 C 14.8,21.1 13.1,22.2 11.2,22.1 C 9.3,22 7.7,20.6 7.2,18.8 C 6.7,16.9 7.6,15.1 9.2,14.2 Z"
                      Stroke="#DC2626" StrokeThickness="1.6" Fill="Transparent"/>
                <Ellipse Canvas.Left="10.5" Canvas.Top="16.5" Width="3" Height="3" Fill="#DC2626"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Generic Fallback Symbol -->
    <DataTemplate x:Key="GenericDeviceVisualTemplate">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Rectangle Canvas.Left="4" Canvas.Top="4" Width="16" Height="16" RadiusX="2" RadiusY="2" Stroke="#475569" StrokeThickness="1.8" Fill="Transparent"/>
                <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="#2563EB"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- DataTemplate Selector for DeviceItem -->
    <DataTemplate DataType="{x:Type models:DeviceItem}">
        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource GenericDeviceVisualTemplate}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding VisualCategory}" Value="LIGHT">
                            <Setter Property="ContentTemplate" Value="{StaticResource SmartLightVisualTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding VisualCategory}" Value="DOOR">
                            <Setter Property="ContentTemplate" Value="{StaticResource DoorSensorVisualTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding VisualCategory}" Value="METER">
                            <Setter Property="ContentTemplate" Value="{StaticResource PowerMeterVisualTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding VisualCategory}" Value="AIR">
                            <Setter Property="ContentTemplate" Value="{StaticResource AirQualityVisualTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding VisualCategory}" Value="CLIMATE">
                            <Setter Property="ContentTemplate" Value="{StaticResource TempHumVisualTemplate}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </DataTemplate>

</ResourceDictionary>
