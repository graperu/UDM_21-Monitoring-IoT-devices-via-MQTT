<Window x:Class="UDM_21.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="UDM_21: Giám Sát &amp; Điều Khiển IoT Qua MQTT (C# .NET 8 WPF)" Height="760" Width="1220"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Connection Bar -->
        <GroupBox Header="Cấu Hình Kết Nối MQTT Broker" Grid.Row="0" Margin="0,0,0,10" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,7">
                    <TextBlock Text="Broker Host:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtHost" Text="broker.emqx.io" Width="145" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtPort" Text="1883" Width="55" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <TextBlock Text="Topic Root:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtTopicRoot" Text="udm21_nhom01" Width="145" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <CheckBox x:Name="ChkTls" Content="TLS" VerticalAlignment="Center"
                              ToolTip="Bật MQTT qua TLS và kiểm tra chứng chỉ broker"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="Username:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtUsername" Width="110" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <TextBlock Text="Password:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <PasswordBox x:Name="TxtPassword" Width="110" VerticalAlignment="Center" Margin="0,0,15,0"
                                 ToolTip="Mật khẩu chỉ giữ trong bộ nhớ, không ghi vào source hoặc log"/>

                    <Button x:Name="BtnConnect" Content="Kết Nối" Width="90" Margin="0,0,10,0" Click="BtnConnect_Click" Background="#28a745" Foreground="White" FontWeight="Bold"/>
                    <Button x:Name="BtnDisconnect" Content="Ngắt Kết Nối" Width="100" Margin="0,0,20,0" IsEnabled="False" Click="BtnDisconnect_Click" Background="#dc3545" Foreground="White" FontWeight="Bold"/>

                    <TextBlock x:Name="LblStatus" Text="Trạng thái: Chưa kết nối" VerticalAlignment="Center" FontWeight="Bold" Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Visual Dashboard & History / Table Views -->
            <Grid Grid.Column="0" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1.6*"/>
                </Grid.RowDefinitions>

                <!-- Visual Devices Cards Grid -->
                <GroupBox Header="Trực Quan Hóa 5 Thiết Bị IoT (Real-Time Visual Devices)" Grid.Row="0" Margin="0,0,0,8" Padding="6">
                    <ItemsControl x:Name="IcDeviceCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" CornerRadius="8" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1.5" Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: Icon & ID -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <Ellipse DockPanel.Dock="Right" Width="9" Height="9" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="Gray"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="Online">
                                                                <Setter Property="Fill" Value="#28a745"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="⚠️ Cảnh báo">
                                                                <Setter Property="Fill" Value="#fd7e14"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="Offline">
                                                                <Setter Property="Fill" Value="#dc3545"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding DeviceId}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- Location & Type -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1" Margin="0,0,3,0">
                                                <TextBlock Text="{Binding DeviceType}" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#6c757d" CornerRadius="3" Padding="4,1">
                                                <TextBlock Text="{Binding Location}" Foreground="White" FontSize="9"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Primary Big Display -->
                                        <Border Grid.Row="2" Background="White" CornerRadius="5" BorderBrush="#E9ECEF" BorderThickness="1" Padding="4,6" Margin="0,2,0,4">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding PrimaryValue}" FontSize="18" FontWeight="ExtraBold" Foreground="#212529"/>
                                                    <TextBlock Text="{Binding PrimaryUnit}" FontSize="12" FontWeight="Bold" Margin="2,0,0,0" VerticalAlignment="Bottom" Foreground="#495057"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SecondaryValue}" FontSize="9" Foreground="#6c757d" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Quick Action or Status -->
                                        <Border Grid.Row="3" Margin="0,2,0,0">
                                            <StackPanel>
                                                <Button Content="{Binding ActionButtonText}" Height="22" FontSize="9.5" FontWeight="Bold" Background="{Binding BadgeColor}" Foreground="White"
                                                        Click="QuickToggle_Click" Tag="{Binding}"/>
                                                <TextBlock Text="{Binding LastSeen}" FontSize="8.5" Foreground="#adb5bd" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <!-- Top Left: Device List Table -->
                <GroupBox Header="Bảng Chi Tiết Thiết Bị Real-Time" Grid.Row="1" Margin="0,0,0,5">
                    <DataGrid x:Name="DgDevices" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="DgDevices_SelectionChanged" MouseDoubleClick="DgDevices_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="110"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding DeviceType}" Width="70"/>
                            <DataGridTextColumn Header="Vị Trí" Binding="{Binding Location}" Width="70"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                                            <Ellipse Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="Gray"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="Online">
                                                                <Setter Property="Fill" Value="LimeGreen"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="⚠️ Cảnh báo">
                                                                <Setter Property="Fill" Value="OrangeRed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusText}" Value="Offline">
                                                                <Setter Property="Fill" Value="Red"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tóm Tắt Dữ Liệu" Binding="{Binding LatestTelemetrySummary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- Bottom Left: Telemetry History DataGrid -->
                <GroupBox Header="Lịch Sử Dữ Liệu Telemetry" Grid.Row="2" Margin="0,5,0,0">
                    <DataGrid x:Name="DgHistory" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Bản Tin" Binding="{Binding MessageId}" Width="100"/>
                            <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="110"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding DeviceType}" Width="70"/>
                            <DataGridTextColumn Header="Vị Trí" Binding="{Binding Location}" Width="70"/>
                            <DataGridTextColumn Header="Thời Gian" Binding="{Binding Timestamp}" Width="130"/>
                            <DataGridTextColumn Header="Dữ Liệu Telemetry" Binding="{Binding DataJson}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <!-- Right: Control Panel & Console -->
            <Grid Grid.Column="1" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Command Box -->
                <GroupBox Header="Gửi Lệnh Điều Khiển (Publish Command)" Grid.Row="0" Margin="0,0,0,10" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Chọn Thiết Bị:" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbDevices" DisplayMemberPath="DeviceId" Margin="0,0,0,8" SelectionChanged="CmbDevices_SelectionChanged"/>

                        <TextBlock Text="Mẫu Lệnh Sẵn Có (Preset Commands):" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbPresetCommands" Margin="0,0,0,8" SelectionChanged="CmbPresetCommands_SelectionChanged"/>

                        <TextBlock Text="Tên Lệnh (Command):" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtCommand" Text="TOGGLE_POWER" Margin="0,0,0,8"/>

                        <TextBlock Text="Tham Số (JSON):" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtParams" Text="{}{&quot;state&quot;: &quot;ON&quot;}" Margin="0,0,0,10"/>

                        <Button x:Name="BtnSendCmd" Content="Phát Lệnh Qua MQTT" Height="30" Click="BtnSendCmd_Click" Background="#007bff" Foreground="White" FontWeight="Bold" IsEnabled="False"/>
                        <TextBlock x:Name="LblCommandStatus" Text="Chưa gửi lệnh" Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Nhật Ký Sự Kiện (Log Console) -->
                <GroupBox Header="Log Console" Grid.Row="1" VerticalAlignment="Stretch">
                    <ListBox x:Name="LbConsole"
                             Background="#1E1E1E" 
                             Foreground="#00FF00" 
                             FontFamily="Consolas"
                             BorderBrush="Transparent"
                             VerticalAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MaxHeight="{Binding Path=ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ListBox.Resources>
                            <!-- Template Vertical ScrollBar -->
                            <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
                                <Grid x:Name="Bg" Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBorder" 
                                                                Background="#4E4E4E" 
                                                                CornerRadius="4" 
                                                                Margin="1"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#6E6E6E"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>

                            <!-- Template Horizontal ScrollBar -->
                            <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
                                <Grid x:Name="Bg" Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBorder" 
                                                                Background="#4E4E4E" 
                                                                CornerRadius="4" 
                                                                Margin="1"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#6E6E6E"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>

                            <Style TargetType="ScrollBar">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
                                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Vertical">
                                        <Setter Property="Width" Value="4"/>
                                        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
                                    </Trigger>
                                    <Trigger Property="Orientation" Value="Horizontal">
                                        <Setter Property="Height" Value="4"/>
                                        <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBox x:Name="TxtConsole"
                                         Text="{Binding Mode=OneWay}" 
                                         IsReadOnly="True"
                                         SelectionBrush="#007ACC"
                                         Background="Transparent"
                                         Foreground="#00FF00"
                                         Padding="0"
                                         BorderThickness="0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
