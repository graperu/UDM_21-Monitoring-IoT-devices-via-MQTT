<Window x:Class="UDM_21.Dashboard.TelemetryHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lịch Sử Đo Lường SQLite - UDM_21 IoT" Height="500" Width="960" MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="LblTitle" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="Lịch Sử Đo Lường"/>
                    <TextBlock x:Name="LblSubtitle" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Text="20 bản tin telemetry gần nhất được truy vấn từ SQLite" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Xóa Lịch Sử" Style="{StaticResource DangerButtonStyle}" Padding="12,6" Margin="0,0,8,0" Click="HistoryDelete_Click"/>
                    <Button Content="Đóng" Padding="14,6" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="2" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="6">
            <DataGrid x:Name="DgHistory" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Thời Gian" Binding="{Binding TimestampFormatted}" Width="160"/>
                    <DataGridTextColumn Header="Thiết Bị" Binding="{Binding DisplayName}" FontWeight="SemiBold" Width="180"/>
                    <DataGridTextColumn Header="Vị Trí" Binding="{Binding LocationFriendly}" Width="130"/>
                    <DataGridTextColumn Header="Chỉ Số Chính" Binding="{Binding PrimaryValue}" FontWeight="Bold" Width="130"/>
                    <DataGridTextColumn Header="Chỉ Số Phụ" Binding="{Binding SecondaryValue}" Width="*"/>
                    <DataGridTemplateColumn Header="Trạng Thái" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBadgeBg}" CornerRadius="2" Padding="6,1.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="10.5"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="4,8,4,0" LastChildFill="False">
            <TextBlock x:Name="LblFooterInfo" Text="Dữ liệu được lưu trữ tự động khi Broker phát thông điệp telemetry." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
